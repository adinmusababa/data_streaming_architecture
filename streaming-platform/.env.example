# Root environment example for ASLP

# General
PROJECT_NAME=streaming-platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base URLs
CONFIG_SERVICE_URL=http://localhost:8001
STREAMING_SERVICE_URL=http://localhost:8002
BROKER_SERVICE_URL=http://localhost:8003
OML_ENGINE_URL=http://localhost:8004
STATE_STORE_URL=http://localhost:8005
STORAGE_SERVICE_URL=http://localhost:8006
MONITORING_DASHBOARD_URL=http://localhost:8501

# Database defaults
DATABASE_URL=sqlite+aiosqlite:///./aslp.db
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Shared SDK
SHARED_SDK_PATH=./shared-sdk
